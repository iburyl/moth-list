# Configuration for the docker compose deployment. Copy to `.env` and fill in.
#
# This file is used ONLY by `docker compose`. Local development on Windows does
# not read it — for dev just export the MOTHS_* vars and run runserver.

# --- Caddy / TLS -------------------------------------------------------------
# Public domain Caddy obtains a certificate for, and the ACME contact email.
SITE_DOMAIN=moths.example.com
ACME_EMAIL=you@example.com

# --- Django ------------------------------------------------------------------
# Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret

# TEMPORARY: gate the whole site behind login (blocks crawlers while the UI is
# in progress). Set to 0 to lift the gate (public viewing, login only to edit).
DJANGO_REQUIRE_LOGIN=1

# --- Dataset (absolute HOST paths, mounted into the web container) -----------
# Images / prediction / names are mounted read-only; labels, cache, and data
# must be writable (pose data, summaries, .class / starred, crop cache, wiki).
MOTHS_IMAGE_DIR_HOST=/srv/moths/images
MOTHS_PREDICTION_DIR_HOST=/srv/moths/prediction
MOTHS_LABEL_DIR_HOST=/srv/moths/labels
MOTHS_THUMBNAIL_DIR_HOST=/srv/moths/cache
MOTHS_DATA_DIR_HOST=/srv/moths/data
MOTHS_NAMES_CSV_HOST=/srv/moths/names.csv
